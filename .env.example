# Development: where `npm run dev` proxies /api (FastAPI server).
DEV_API_TARGET=http://localhost:8000

# Build time (optional): call the backend directly instead of through /api on the same origin.
# Leave empty when nginx proxies /api (recommended). Requires CORS on the backend if set.
VITE_API_BASE_URL=

# Docker / Coolify runtime: where nginx forwards /api/* (no trailing slash).
BACKEND_URL=http://backend:8000
